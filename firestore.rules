rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin đã đăng nhập đúng email mới được toàn quyền ghi.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'mhieusz.23.dkc@gmail.com';
    }

    // Khách (CHƯA đăng nhập) chỉ được phép cập nhật ĐÚNG 3 field:
    //   Phone, isActive, time_updated — và bắt buộc đặt isActive = true.
    // Dùng cho luồng kích hoạt lần đầu ở trang đếm ngược (nhập số điện thoại).
    function isGuestActivation() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['Phone', 'isActive', 'time_updated'])
        && request.resource.data.isActive == true;
    }

    // Khách gửi câu trả lời + xác nhận tham dự: chỉ được sửa ĐÚNG 3 field:
    //   address, isConfirm, time_updated — và bắt buộc đặt isConfirm = true.
    // Dùng cho nút "Gửi" ở màn chi tiết lời mời.
    function isGuestConfirm() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['address', 'isConfirm', 'time_updated'])
        && request.resource.data.isConfirm == true;
    }

    // Collection users:
    //   ĐỌC: công khai (khách tra cứu theo mã code).
    //   TẠO / XÓA: chỉ admin.
    //   CẬP NHẬT: admin (mọi field) HOẶC khách (kích hoạt / xác nhận như trên).
    match /users/{userId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isGuestActivation() || isGuestConfirm();
    }

    // Mọi document khác: đọc công khai, ghi chỉ admin (giữ như cũ).
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
